#!/bin/bash
# systemd-logind system-sleep hook. Installed to
# /usr/lib/systemd/system-sleep/lock-before-sleep (root-owned, chmod 755 —
# systemd refuses to run group/other-writable hooks here).
#
# Runs as root for EVERY suspend, regardless of what triggered it (lid close,
# IdleManager's idle-timeout auto-suspend, the manual Suspend button in the
# dashboard, a bare `systemctl suspend`) — one place to guarantee the session
# locks before the screen goes dark, instead of every trigger needing its own
# lock-then-suspend dance. logind waits for the "pre" call to return before
# actually suspending, so a synchronous sleep here reliably orders
# lock-before-sleep with no race against the suspend itself.
[[ "$1" == "pre" ]] || exit 0

USER_NAME="deadlock"
USER_ID=$(id -u "$USER_NAME") || exit 0
RUNTIME_DIR="/run/user/$USER_ID"
WAYLAND_SOCK=$(find "$RUNTIME_DIR" -maxdepth 1 -name 'wayland-*' ! -name '*.lock' -printf '%f\n' 2>/dev/null | head -1)

[[ -n "$WAYLAND_SOCK" ]] || exit 0

# runuser (not sudo -u): sudo does a hostname lookup for its audit log on
# every invocation, which hangs for a long time on a box whose /etc/hosts
# has no entry for its own hostname (confirmed the case here) — especially
# bad right as network interfaces are going down for suspend. runuser skips
# all of that. `timeout` is a second line of defense so a hung IPC call
# can never block logind from suspending at all (screen freeze instead of
# sleep, confirmed live).
timeout 3 runuser -u "$USER_NAME" -- env \
    XDG_RUNTIME_DIR="$RUNTIME_DIR" \
    WAYLAND_DISPLAY="$WAYLAND_SOCK" \
    qs ipc call lock lock

sleep 1
