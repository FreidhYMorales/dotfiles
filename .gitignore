# ── Sensitive — never commit ──────────────────────────────────────────────────
dotfiles/zsh/.config/zsh/secrets.zsh

# ── External plugins/flavors — cloned by bootstrap (ya pack -i / git clone),
# re-fetched on every fresh install, not useful to track here ────────────────
dotfiles/yazi/.config/yazi/plugins/*/
dotfiles/yazi/.config/yazi/flavors/*/

# ── Font cache — regenerated by fc-cache ──────────────────────────────────────
dotfiles/fonts/.local/share/fonts/.uuid

# ── Matugen-generated theme outputs — rewritten on every wallpaper/theme
# change, would dirty git status constantly if tracked ───────────────────────
dotfiles/matugen/.config/matugen/colors.json
dotfiles/matugen/.config/matugen/output/
dotfiles/kitty/.config/kitty/matugen-theme.conf
dotfiles/btop/.config/btop/themes/matugen.theme
dotfiles/hypr/.config/hypr/deadlock/colors.lua
dotfiles/hypr/.config/hypr/hyprpaper.conf
dotfiles/zellij/.config/zellij/themes/

# ── Runtime state — not config ────────────────────────────────────────────────
dotfiles/mpd/.config/mpd/database
dotfiles/mpd/.config/mpd/log
dotfiles/mpd/.config/mpd/state
dotfiles/mpd/.config/mpd/sticker.sql
dotfiles/ncmpcpp/.config/ncmpcpp/error.log

# ── Runtime-generated by sddm-theme-sync / matugen ───────────────────────────
system/sddm/themes/silent/configs/custom.conf
system/sddm/themes/silent/backgrounds/qs-current.*

# ── Tool cache / local settings ──────────────────────────────────────────────
**/.atl/*.cache.json
**/.claude/settings.local.json

# ── Stow artifact — repo-root .config should never exist here ────────────────
/.config

# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~
*.swp
*.swo
