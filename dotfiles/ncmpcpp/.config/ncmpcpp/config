# Only settings that differ from ncmpcpp's defaults
# (reference: /usr/share/doc/ncmpcpp/config).

# Directories
lyrics_directory = ~/.config/ncmpcpp/lyrics
mpd_music_dir = ~/Music

# Visualizer (reads mpd's "my_fifo" output at the default /tmp/mpd.fifo)
visualizer_output_name = my_fifo
visualizer_look = ●●
visualizer_color = cyan, blue, magenta

# Interface
search_engine_display_mode = columns
autocenter_mode = yes
centered_cursor = yes
progressbar_look = "─╼ "
user_interface = alternative
