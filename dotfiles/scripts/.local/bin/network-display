#!/bin/bash
# Cast la pantalla completa a un receptor Miracast (TV/proyector) via
# gnome-network-displays.
#
# xdg-desktop-portal-hyprland no implementa el portal RemoteDesktop que
# gnome-network-displays necesita para negociar la sesión WFD (issue abierto
# upstream, sin fecha de merge). xdg-desktop-portal-wlr sí lo cubre lo
# suficiente para castear un output físico — pero es peor backend para el
# uso diario (Discord/OBS/videollamadas pierden el picker por ventana de
# Hyprland). Este script alterna el backend de ScreenCast a wlr solo
# mientras dura la sesión de casting, y lo devuelve a hyprland al cerrar
# (incluso si gnome-network-displays crashea al salir — bug conocido,
# "double free" en nd_pulseaudio_finalize, no afecta el streaming en sí).
#
# Deps: gnome-network-displays, xdg-desktop-portal-wlr, avahi (mDNS discovery)

set -euo pipefail

PORTAL_CONF="$HOME/.config/xdg-desktop-portal/hyprland-portals.conf"

restore_portal() {
  sed -i 's/^org\.freedesktop\.impl\.portal\.ScreenCast=.*/org.freedesktop.impl.portal.ScreenCast=hyprland/' "$PORTAL_CONF"
  systemctl --user restart xdg-desktop-portal-hyprland.service xdg-desktop-portal.service
}

trap restore_portal EXIT

sed -i 's/^org\.freedesktop\.impl\.portal\.ScreenCast=.*/org.freedesktop.impl.portal.ScreenCast=wlr/' "$PORTAL_CONF"
systemctl --user restart xdg-desktop-portal-wlr.service xdg-desktop-portal.service

GDK_BACKEND=wayland gnome-network-displays
